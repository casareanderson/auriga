{
  "manifest_version": 3,
  "name": "Auriga",
  "version": "0.3.0",
  "description": "Drive this Chrome from any local tool via a localhost HTTP bridge (no native host).",
  "key": "",
  "permissions": ["tabs", "activeTab", "scripting", "downloads", "cookies", "alarms", "debugger", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": { "default_title": "Auriga", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
